<IfModule mod_rewrite.c>
    RewriteEngine On

    # Error pages
    ErrorDocument 404 /errors/404.html
    ErrorDocument 500 /errors/500.html

    # Ensure existing files and directories take priority
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ $1 [L]
</IfModule>
